MONGODB_URI=mongodb://localhost:27018/episteme
PORT=4000

# Authentification à l'origine. Si EPISTEME_REQUIRE_AUTH=1, le serveur refuse
# de démarrer sans phrase de passe ni secret de session.
# Générer : python3 -c "import secrets;print(secrets.token_hex(32))"
EPISTEME_PASSPHRASE=
EPISTEME_SESSION_SECRET=
EPISTEME_REQUIRE_AUTH=0

# Cloudflare Access en amont. Si ces deux variables sont fournies, un JWT Access
# valide authentifie la personne et la phrase de passe n'est pas demandée.
# L'AUD se lit sur l'application Access (API ou tableau de bord Zero Trust).
EPISTEME_ACCESS_TEAM_DOMAIN=
EPISTEME_ACCESS_AUD=
